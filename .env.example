# Copy to .env and fill in values (optional — export vars or use Streamlit secrets instead)
# cp .env.example .env

# --- OpenAI (provider: openai) ---
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (provider: anthropic; pip install anthropic) ---
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# --- Ollama (provider: ollama; local, no API key) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- PromptGuard ---
# SQLite path for saved evaluation runs (default: ~/.promptguard/history.db)
# PROMPTGUARD_HISTORY_DB=

# Logging
LOG_LEVEL=INFO
